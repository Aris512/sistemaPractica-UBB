# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.
# En desarrollo local solo son obligatorias las credenciales de administración; en producción
# (docker-compose.prod.yml) se usan todas.

# Credenciales del panel de administración (/admin)
# OBLIGATORIO: Sin estas variables el acceso a /admin queda BLOQUEADO completamente.
ADMIN_BASIC_USERNAME=
ADMIN_BASIC_PASSWORD=

# Base de datos MySQL (producción): descomenta y define contraseñas propias en el .env del servidor.
# En desarrollo déjalas comentadas: un valor vacío reemplazaría la conexión al MySQL local.
# DB_NAME=proyecto_db
# DB_USER=proyecto_user
# DB_PASSWORD=
# MYSQL_ROOT_PASSWORD=

# Chatbot de IA con Groq. La clave se obtiene en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Puerto del servidor donde Nginx publica la aplicación (Podman sin root: 1024 o superior)
FRONTEND_PORT=8080
