# ==========================================================
# Plantilla de variables de entorno. SÍ se sube a Git.
# Copiar este archivo como .env y completar los valores.
#   cp .env.example .env
# NUNCA subir el archivo .env real (está en .gitignore).
# ==========================================================

# --- Base de datos MySQL ---
DB_URL=jdbc:mysql://localhost:3306/proyecto_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=proyecto_user
DB_PASSWORD=

# Contraseña root del contenedor MySQL de docker-compose
DB_ROOT_PASSWORD=

# --- Credenciales del panel de administración (/admin) ---
# OBLIGATORIO: sin estas variables el acceso a /admin queda BLOQUEADO.
ADMIN_BASIC_USERNAME=tu_usuario_admin
ADMIN_BASIC_PASSWORD=tu_contrasena_segura
