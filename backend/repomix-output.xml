            doc.setUbicacion(stored.relativePath());
            doc.setFechaCarga(LocalDateTime.now());
            doc.setEstado("ENTREGADO");
            doc.setTamanioBytes(stored.sizeBytes());
        } else {
            doc = new DocumentoPractica(
