        {
          "name": "3. Enviar mensaje al Chatbot IA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"La respuesta es JSON\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Estructura válida y respuesta de texto no vacía (sin validar texto exacto)\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"object\");",
                  "    pm.expect(body).to.have.property(\"conversacion\");",
                  "    pm.expect(body).to.have.property(\"mensajeUsuario\");",
                  "    pm.expect(body).to.have.property(\"mensajeAsistente\");",
                  "",
                  "    pm.expect(body.mensajeUsuario.rol).to.eql(\"USER\");",
                  "    pm.expect(body.mensajeUsuario.contenido).to.be.a(\"string\").and.not.be.empty;",
                  "",
                  "    pm.expect(body.mensajeAsistente.rol).to.eql(\"ASSISTANT\");",
                  "    pm.expect(body.mensajeAsistente.contenido).to.be.a(\"string\");",
                  "    pm.expect(body.mensajeAsistente.contenido.trim().length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Tiempo de respuesta dentro del umbral RNF para IA (< 15000 ms)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(15000);",
                  "});"
                ]
              }
