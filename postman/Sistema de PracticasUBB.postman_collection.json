          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Status code check\npm.test(\"Status is 404 - owner not found (deleted)\", function () {\n    pm.response.to.have.status(404);\n});\n\n// 2. Response time check\npm.test(\"Response time is less than 3000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(3000);\n});\n\n// 3. Response has a body\npm.test(\"Response body is not empty\", function () {\n    pm.expect(pm.response.text()).to.not.be.empty;\n});\n\n// 4. Body does not contain an owner id (confirms deletion)\npm.test(\"Response does not return owner data (no id field)\", function () {\n    try {\n        const json = pm.response.json();\n        pm.expect(json).to.not.have.property(\"id\");\n    } catch (e) {\n        // Non-JSON body is also acceptable for 404\n        pm.expect(pm.response.text()).to.not.include('\"id\"');\n    }\n});"
            ]
          }
        }
      ],
