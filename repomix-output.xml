import { useState, useEffect, useRef } from "react";
import {
  ClipboardCheck,
  ArrowLeft,
  RefreshCw,
  AlertCircle,
  Calendar,
  BookOpen,
  User,
  Upload,
  FileCheck2,
  Clock,
  X,
