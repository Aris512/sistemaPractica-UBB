interface PerfilProfesorProps {
  user: UserSession;
  onBack?: () => void;
}

export function PerfilProfesor({ user, onBack }: PerfilProfesorProps) {
  const rolDisplay = (user.roles && user.roles[0]) || user.rol || "Tutor de Práctica / Profesor Colaborador";
  const fullName = `${user.nombre || ""} ${user.apellido || ""}`.trim().toUpperCase() || "DOCENTE TUTOR";
  const [especialidad, setEspecialidad] = useState<string>("Pedagogía y Gestión de Aula en Terreno");

  useEffect(() => {
    if (!user?.rut) return;

    // Intentar consultar datos adicionales si existen en el backend
    fetch(`http://localhost:8080/api/profesores/rut/${encodeURIComponent(user.rut)}`)
      .then((res) => {
        if (!res.ok) return null;
        return res.json();
      })
      .then((data) => {
        if (data?.asignatura?.nombre) {
          setEspecialidad(data.asignatura.nombre);
        }
      })
      .catch(() => {});
